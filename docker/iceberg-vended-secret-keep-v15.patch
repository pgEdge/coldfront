# iceberg-vended-secret-keep-v15.patch
#
# Applies to: duckdb-iceberg @ 5edc45f0 (branch v1.5-variegata), DuckDB v1.5.x,
# after iceberg-schema-id-allocation-v15.patch.
#
# Problem: under ACCESS_DELEGATION_MODE VENDED_CREDENTIALS, every scan bind of
# a table (IcebergTableEntry::GetScanFunction -> PrepareIcebergScanFromEntry ->
# GetVendedCredentials) creates the table's temporary storage secret again,
# under a name fixed for the transaction, with REPLACE_ON_CONFLICT. DuckDB
# v1.5.4 replaces a secret by dropping it and then writing the new one
# (CatalogSetSecretStorage::StoreSecret, src/main/secret/secret_storage.cpp),
# so between the two steps the table has no secret. A statement that reads the
# table twice in one transaction (a self-join, a UNION, the two arms of
# ColdFront's vector probe) binds it twice; the first bind's manifest reads run
# on worker threads and look the secret up when they open a file, and one that
# opens a manifest in the gap finds none, goes unsigned to DuckDB's default
# endpoint and gets an HTTP 403. Without iceberg-manifest-read-error-v15.patch
# that 403 aborts the backend.
#
# Fix: IGNORE_ON_CONFLICT on both secret inputs. A repeat bind in the same
# transaction keeps the secret already there: every bind of a transaction
# builds the same secret from the same cached table load, the only caller
# discards CreateSecret's result (empty for an ignored repeat), and the
# transaction still drops its secrets at its end
# (IcebergTransaction::DropSecrets). At the pinned ref nothing refreshes a
# vended credential inside a transaction.
#
# The race has no deterministic trigger (a worker thread must open a file
# inside the drop-to-write gap), so no CI check covers it; measured by hand,
# 7,200 double-read sessions passed with the patch against 3 to 4 backend
# aborts per 1,200 without. Drop the patch when ICEBERG_REF moves to a ref that
# keeps the secret: git apply --check then fails on the removed lines.
#
diff --git a/src/catalog/rest/catalog_entry/table/iceberg_table_information.cpp b/src/catalog/rest/catalog_entry/table/iceberg_table_information.cpp
index 667850d35..406dfe302 100644
--- a/src/catalog/rest/catalog_entry/table/iceberg_table_information.cpp
+++ b/src/catalog/rest/catalog_entry/table/iceberg_table_information.cpp
@@ -222,7 +222,7 @@ IRCAPITableCredentials IcebergTableInformation::GetVendedCredentials(ClientConte
 		}
 
 		CreateSecretInput create_secret_input;
-		create_secret_input.on_conflict = OnCreateConflict::REPLACE_ON_CONFLICT;
+		create_secret_input.on_conflict = OnCreateConflict::IGNORE_ON_CONFLICT;
 		create_secret_input.persist_type = SecretPersistType::TEMPORARY;
 
 		if (ignore_credential_prefix) {
@@ -252,7 +252,7 @@ IRCAPITableCredentials IcebergTableInformation::GetVendedCredentials(ClientConte
 		//! Only create a secret out of the 'config' if there are no 'storage-credentials'
 		result.config = make_uniq<CreateSecretInput>();
 		auto &config = *result.config;
-		config.on_conflict = OnCreateConflict::REPLACE_ON_CONFLICT;
+		config.on_conflict = OnCreateConflict::IGNORE_ON_CONFLICT;
 		config.persist_type = SecretPersistType::TEMPORARY;
 
 		//! TODO: apply the 'overrides' retrieved from the /v1/config endpoint
