# ColdFront image on the DuckDB 1.5.x stack: the thin coldfront layer on top of
# the prebuilt coldfront-duckdb-base. The base (docker/Dockerfile.duckdb15-base)
# holds the expensive, stable compiles, pg_duckdb (DuckDB 1.5.4, patched) and the
# patched duckdb-iceberg extensions (iceberg/avro/azure/postgres_scanner,
# v1.5-variegata). This build only compiles the coldfront C extension (seconds),
# so CI and local builds are fast and always test the current coldfront source.
#
# COLDFRONT_BASE is the prebuilt ghcr.io/pgedge base image. Before building,
# either pull it from ghcr.io/pgedge/coldfront-duckdb-base or build it locally
# first (it is then used from the local image cache):
#   docker build -f docker/Dockerfile.duckdb15-base --build-arg PG_MAJOR=18 \
#       -t ghcr.io/pgedge/coldfront-duckdb-base:pg18 .
#
#   docker build -f docker/Dockerfile.duckdb15 --build-arg PG_MAJOR=18 \
#       --secret id=repo_client_crt,src=client.crt \
#       --secret id=repo_client_key,src=client.key \
#       -t coldfront-duckdb15:pg18 .
#
# The pgEdge repos need a client cert (mTLS). It comes in as BuildKit secrets,
# mounted only into the installing RUNs; each RUN's trap deletes the installed
# copy and disables the repos, so no layer holds it. Compose reads it from
# REPO_CLIENT_CRT / REPO_CLIENT_KEY (default ./client.crt, ./client.key).
ARG PG_MAJOR=18
ARG PGEDGE_TAG=${PG_MAJOR}-spock5-minimal
ARG COLDFRONT_BASE=ghcr.io/pgedge/coldfront-duckdb-base:pg${PG_MAJOR}

# ─── coldfront compile stage: PG devel headers only (no pg_duckdb linkage) ───────
# coldfront.c includes only PostgreSQL server headers + libpq-fe.h and links -lpq;
# it does NOT link pg_duckdb, so this stage needs just the PG devel toolchain and
# builds in seconds (the heavy pg_duckdb/iceberg compiles live in the base).
FROM ghcr.io/pgedge/pgedge-postgres:${PGEDGE_TAG} AS cf-build
ARG PG_MAJOR
USER root
# Repos are gated and disabled in the parent; see the header.
RUN --mount=type=secret,id=repo_client_crt,required=true \
    --mount=type=secret,id=repo_client_key,required=true \
    set -eu; \
    trap 'rm -f /etc/pki/pgedge/client.crt /etc/pki/pgedge/client.key; dnf config-manager --set-disabled "pgedge*" >/dev/null 2>&1 || true' EXIT; \
    pgedge-subscription-manager install /run/secrets/repo_client_crt /run/secrets/repo_client_key --force; \
    dnf install -y --setopt=install_weak_deps=False \
        pgedge-postgresql${PG_MAJOR}-devel gcc make redhat-rpm-config diffutils; \
    dnf clean all
ENV PATH=/usr/pgsql-${PG_MAJOR}/bin:$PATH
ENV PG_CONFIG=/usr/pgsql-${PG_MAJOR}/bin/pg_config
COPY extension/coldfront /build/coldfront
RUN DESTDIR=/out make -C /build/coldfront install with_llvm=no

# ─── app runtime: coldfront extension on top of the base ─────────────────────────
# pg_duckdb 1.5.4, the iceberg/avro/azure/postgres_scanner extensions, libcurl
# 8.12, COLDFRONT_DUCKDB_* env and /data are inherited from the base. This stage
# adds coldfront's .so + SQL/control (distinct filenames, so nothing of
# pg_duckdb is overwritten) and the entrypoint.
#
# entrypoint.sh holds frequently-changing runtime config (e.g. the
# duckdb.postgres_role default) and lives only here, in the fast app layer, so
# every build, local and GitHub CI alike, runs the branch's current entrypoint
# and an entrypoint change never needs a base rebuild.
FROM ${COLDFRONT_BASE}
ARG PG_MAJOR
USER root
COPY --from=cf-build /out/usr/pgsql-${PG_MAJOR}/lib/             /usr/pgsql-${PG_MAJOR}/lib/
COPY --from=cf-build /out/usr/pgsql-${PG_MAJOR}/share/extension/ /usr/pgsql-${PG_MAJOR}/share/extension/
COPY docker/entrypoint.sh /usr/local/bin/coldfront-entrypoint.sh
COPY docker/coldfront-materialize-secret.sh /usr/local/bin/coldfront-materialize-secret.sh
RUN chmod +x /usr/local/bin/coldfront-entrypoint.sh /usr/local/bin/coldfront-materialize-secret.sh
# pgvector, from the same pgEdge repo the base is built from. A tiered vector
# table has the type on its hot side, and both the cold read and cold write
# paths rely on pgvector's implicit vector -> real[] cast. It sits in the app
# layer for the same reason as entrypoint.sh: baked only into the separately
# published base, a stale base would silently lack it and local CI would diverge
# from GitHub CI.
#
# An older base has a pre-gating pgedge-release (repo enabled, no
# pgedge-subscription-manager): disable it and upgrade pgedge-release first.
RUN --mount=type=secret,id=repo_client_crt,required=true \
    --mount=type=secret,id=repo_client_key,required=true \
    set -eu; \
    trap 'rm -f /etc/pki/pgedge/client.crt /etc/pki/pgedge/client.key; dnf config-manager --set-disabled "pgedge*" >/dev/null 2>&1 || true' EXIT; \
    dnf config-manager --set-disabled "pgedge*" >/dev/null 2>&1 || true; \
    command -v pgedge-subscription-manager >/dev/null 2>&1 \
        || dnf install -y --disablerepo="pgedge*" \
           https://downloads.pgedge.com/reporpm/pgedge-release-latest.noarch.rpm; \
    pgedge-subscription-manager install /run/secrets/repo_client_crt /run/secrets/repo_client_key --force; \
    dnf install -y --setopt=install_weak_deps=False pgedge-pgvector_${PG_MAJOR}; \
    dnf clean all
# License + third-party notices travel with the binaries we redistribute (the
# DuckDB family is MIT: the notice must accompany the distributed Software).
COPY THIRD_PARTY_NOTICES.md LICENSE.md /usr/share/doc/coldfront/
USER postgres
ENTRYPOINT ["/usr/local/bin/coldfront-entrypoint.sh"]
