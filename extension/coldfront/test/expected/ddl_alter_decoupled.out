HINT:  Release it with coldfront.release_iceberg_table() and adopt again with p_writable => true to change its columns.
CONTEXT:  PL/pgSQL function _mirror_iceberg_alter(text,text,jsonb) line 17 at RAISE
SQL statement "SELECT coldfront._mirror_iceberg_alter('"ice"."default"."dkr"', NULL, jsonb_build_array(jsonb_build_object('op', 'rename', 'col', 'id', 'newcol', 'ident')))"
-- Nothing refused changed a view.
SELECT attrelid::regclass AS view, string_agg(attname, ', ' ORDER BY attnum) AS columns
  FROM pg_attribute WHERE attrelid IN ('public.dk'::regclass, 'public.dkv'::regclass, 'public.dkr'::regclass)
   AND attnum > 0
 GROUP BY attrelid ORDER BY 1;
 view |       columns        
------+----------------------
 dk   | id, qty, amount, doc
 dkv  | id, emb
 dkr  | id
(3 rows)

-- Cleanup. Unregister first: the DDL hook blocks DROP of a registered view.
DELETE FROM coldfront.tiered_views WHERE schema_name = 'public' AND relname IN ('dk', 'dkv', 'dkr');
DROP VIEW public.dk, public.dkv, public.dkr;
DROP ROLE dk_reader;
DROP ROLE dk_owner;
