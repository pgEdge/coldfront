-- A read-only table refuses every column change.
SELECT coldfront._register_iceberg_view('public', 'dkr', '"ice"."default"."dkr"',
    '[{"name": "id", "cast": "bigint"}]', '{}', false);
 _register_iceberg_view 
------------------------
 
(1 row)

ALTER TABLE public.dkr ADD COLUMN note text;
ERROR:  coldfront: "public.dkr" is adopted read-only
HINT:  Release it with coldfront.release_iceberg_table() and adopt again with p_writable => true to change its columns.
CONTEXT:  PL/pgSQL function _mirror_iceberg_alter(text,text,jsonb) line 17 at RAISE
SQL statement "SELECT coldfront._mirror_iceberg_alter('"ice"."default"."dkr"', NULL, jsonb_build_array(jsonb_build_object('op', 'add', 'col', 'note', 'type', 'text')))"
ALTER TABLE public.dkr RENAME COLUMN id TO ident;
