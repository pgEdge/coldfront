-- A JSON aggregate on the cold write path. DuckDB has neither jsonb_agg nor
-- json_agg, and its json_group_array is a macro that refuses the ORDER BY an
-- aggregate carries, so the rewrite target is to_json(array_agg(...)): both
-- engines have those, and array_agg keeps the ORDER BY. The cold half of the
-- write gets the read rewrite, which builds that form. The values here go to a
-- json column, which takes the text DuckDB computes; a cold write refuses such a
-- value for a jsonb column (cold_write_jsonb_form). Two halves:
--   (A) white-box: the deparsed cold SQL carries to_json(array_agg(...)) for an
--       UPDATE (with and without ORDER BY) and for an INSERT ... SELECT.
--   (B) parity: DuckDB accepts the target and rejects what it replaces.
-- White-box: we do NOT exercise Iceberg I/O.
-- Suppress NOTICEs: raw_query echoes each DuckDB result as a (version-dependent)
-- NOTICE, and CREATE EXTENSION emits "already exists" depending on suite order.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS pg_duckdb;
CREATE EXTENSION IF NOT EXISTS coldfront;
SET TIME ZONE 'UTC';
SET coldfront.warehouse = '';
SET coldfront.lakekeeper_endpoint = '';
CREATE TABLE public._events (id int, ts timestamptz, data jsonb, j json);
CREATE VIEW public.events AS SELECT * FROM public._events;
CREATE TABLE public.src (k text);
INSERT INTO public.src VALUES ('b'), ('a');
INSERT INTO coldfront.tiered_views(schema_name, relname, hot_table, iceberg_table, partition_col)
VALUES ('public', 'events', 'public._events', 'ice.default.events', 'ts');
INSERT INTO coldfront.archive_watermark(schema_name, table_name, cutoff_time)
VALUES ('public', 'events', '2026-03-01'::timestamptz);
-- (A1) Cold UPDATE, aggregate carrying ORDER BY: the ORDER BY rides along inside
-- array_agg, which is an aggregate in DuckDB (json_group_array is not).
EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events SET j = (SELECT jsonb_agg(k ORDER BY k)::json FROM public.src)
WHERE ts < '2019-01-01'::timestamptz;
                                                                                                                                 QUERY PLAN                                                                                                                                 
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _exec_iceberg_with_claim('ice.default.events'::text, 'UPDATE ice.default.events events SET j = ( SELECT ((to_json(array_agg(src.k ORDER BY src.k)))::json)::json AS json_agg            FROM src)   WHERE (ts < ''2019-01-01 00:00:00+00''::timestamptz)'::text)
(2 rows)

-- (A2) Cold UPDATE, no ORDER BY.
EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events SET j = (SELECT jsonb_agg(k)::json FROM public.src)
WHERE ts < '2019-01-01'::timestamptz;
                                                                                                                         QUERY PLAN                                                                                                                          
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _exec_iceberg_with_claim('ice.default.events'::text, 'UPDATE ice.default.events events SET j = ( SELECT ((to_json(array_agg(src.k)))::json)::json AS json_agg            FROM src)   WHERE (ts < ''2019-01-01 00:00:00+00''::timestamptz)'::text)
(2 rows)

-- (A3) The json_ spelling takes the same rewrite.
EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events SET j = (SELECT json_agg(k) FROM public.src)
WHERE ts < '2019-01-01'::timestamptz;
                                                                                                                 QUERY PLAN                                                                                                                  
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _exec_iceberg_with_claim('ice.default.events'::text, 'UPDATE ice.default.events events SET j = ( SELECT to_json(array_agg(src.k)) AS json_agg            FROM src)   WHERE (ts < ''2019-01-01 00:00:00+00''::timestamptz)'::text)
(2 rows)

-- (A4) INSERT ... SELECT: the source runs in PostgreSQL, once, so the aggregate
-- stays jsonb_agg and both halves read its result.
EXPLAIN (COSTS OFF, VERBOSE)
INSERT INTO public.events
SELECT 9, '2019-01-01'::timestamptz, jsonb_agg(k ORDER BY k), NULL FROM public.src;
                                                                                                                                           QUERY PLAN                                                                                                                                            
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: (InitPlan 4).col1, (InitPlan 5).col1
   CTE coldfront_source
     ->  Subquery Scan on coldfront_src
           Output: coldfront_src.id, coldfront_src.ts, coldfront_src.data, (coldfront_src.j)::json
           ->  Aggregate
                 Output: 9, 'Tue Jan 01 00:00:00 2019 UTC'::timestamp with time zone, jsonb_agg(src.k ORDER BY src.k), NULL::text
                 ->  Sort
                       Output: src.k
                       Sort Key: src.k
                       ->  Seq Scan on public.src
                             Output: src.k
   CTE coldfront_hot
     ->  Insert on public._events
           Output: 1
           ->  CTE Scan on coldfront_source
                 Output: coldfront_source.id, coldfront_source.ts, coldfront_source.data, coldfront_source.j
                 Filter: (coldfront_source.ts >= 'Sun Mar 01 00:00:00 2026 UTC'::timestamp with time zone)
   CTE coldfront_cold
     ->  Aggregate
           Output: _cold_sink('public'::text, 'events'::text, (string_agg((('('::text || _cold_row_literal(_canonical_jsonb(r.*), '{id,ts,data,j}'::text[], '{integer,"timestamp with time zone",jsonb,json}'::text[], 'public'::text, 'events'::text)) || ')'::text), ', '::text)), (count(*)))
           ->  HashAggregate
                 Output: string_agg((('('::text || _cold_row_literal(_canonical_jsonb(r.*), '{id,ts,data,j}'::text[], '{integer,"timestamp with time zone",jsonb,json}'::text[], 'public'::text, 'events'::text)) || ')'::text), ', '::text), count(*), r.coldfront_batch
                 Group Key: r.coldfront_batch
                 ->  Subquery Scan on r
                       Output: r.coldfront_batch, r.*
                       ->  WindowAgg
                             Output: coldfront_source_1.id, coldfront_source_1.ts, (coldfront_source_1.data)::text, (coldfront_source_1.j)::text, ((row_number() OVER (?) - 1) / (current_setting('coldfront.cold_write_batch_size'::text))::integer)
                             ->  CTE Scan on coldfront_source coldfront_source_1
                                   Output: coldfront_source_1.id, coldfront_source_1.ts, coldfront_source_1.data, coldfront_source_1.j
                                   Filter: (coldfront_source_1.ts < 'Sun Mar 01 00:00:00 2026 UTC'::timestamp with time zone)
   InitPlan 4
     ->  Aggregate
           Output: count(*)
           ->  CTE Scan on coldfront_hot
                 Output: coldfront_hot."?column?"
   InitPlan 5
     ->  CTE Scan on coldfront_cold
           Output: coldfront_cold.n
(39 rows)

-- (A5) An aggregate nested inside an object builder: each is rewritten in place.
EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events
SET j = (SELECT jsonb_build_object('all', jsonb_agg(k ORDER BY k))::json FROM public.src)
WHERE ts < '2019-01-01'::timestamptz;
                                                                                                                                                                                                   QUERY PLAN                                                                                                                                                                                                   
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _exec_iceberg_with_claim('ice.default.events'::text, 'UPDATE ice.default.events events SET j = ( SELECT ((concat(''{''::text, (to_json((''all'')::text))::text, '':''::text, COALESCE(((to_json(array_agg(src.k ORDER BY src.k)))::json)::text, ''null''::text), ''}''::text))::json)::json AS json_build_object            FROM src)   WHERE (ts < ''2019-01-01 00:00:00+00''::timestamptz)'::text)
(2 rows)

-- (A6) A hot-tier UPDATE is plain PostgreSQL DML: jsonb_agg stays, and the
-- column stays jsonb.
EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events SET data = (SELECT jsonb_agg(k) FROM public.src)
WHERE ts >= '2026-06-01'::timestamptz;
                                       QUERY PLAN                                        
-----------------------------------------------------------------------------------------
 Update on public._events events
   InitPlan 1
     ->  Aggregate
           Output: jsonb_agg(src.k)
           ->  Seq Scan on public.src
                 Output: src.k
   ->  Seq Scan on public._events events
         Output: (InitPlan 1).col1, events.ctid
         Filter: (events.ts >= 'Mon Jun 01 00:00:00 2026 UTC'::timestamp with time zone)
(9 rows)

-- (A7) The aggregate's name inside a string literal is not a call: left intact.
EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events SET j = to_jsonb('jsonb_agg(x) ' || id)::json
WHERE ts < '2019-01-01'::timestamptz;
                                                                                                    QUERY PLAN                                                                                                     
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _exec_iceberg_with_claim('ice.default.events'::text, 'UPDATE ice.default.events SET j = (to_json((''jsonb_agg(x) ''::text || id)))::json   WHERE (ts < ''2019-01-01 00:00:00+00''::timestamptz)'::text)
(2 rows)

-- (A8) The reverse nesting of (A5): a builder inside the aggregate, with an
-- operator applied to the builder's result, which stays inside array_agg with
-- the ORDER BY.
EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events
SET j = (SELECT jsonb_agg(jsonb_build_object('k', k) ->> 'k' ORDER BY k)::json FROM public.src)
WHERE ts < '2019-01-01'::timestamptz;
                                                                                                                                                                                                           QUERY PLAN                                                                                                                                                                                                           
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _exec_iceberg_with_claim('ice.default.events'::text, 'UPDATE ice.default.events events SET j = ( SELECT ((to_json(array_agg(((concat(''{''::text, (to_json((''k'')::text))::text, '':''::text, COALESCE((to_json(src.k))::text, ''null''::text), ''}''::text))::json ->> ''k''::text) ORDER BY src.k)))::json)::json AS json_agg            FROM src)   WHERE (ts < ''2019-01-01 00:00:00+00''::timestamptz)'::text)
(2 rows)

-- (B) Parity against the live DuckDB: the target is accepted (ordered and not),
-- and both spellings it replaces are rejected. A void row = accepted.
SELECT duckdb.raw_query($$ SELECT to_json(array_agg(x ORDER BY x)) FROM (VALUES ('b'),('a')) v(x) $$);
 raw_query 
-----------
 
(1 row)

SELECT duckdb.raw_query($$ SELECT to_json(array_agg(x)) FROM (VALUES ('b'),('a')) v(x) $$);
 raw_query 
-----------
 
(1 row)

SELECT duckdb.raw_query($$ SELECT json_agg(x) FROM (VALUES ('a')) v(x) $$);
ERROR:  (PGDuckDB/pgduckdb_raw_query_cpp) Catalog Error: Scalar Function with name json_agg does not exist!
Did you mean "json"?

LINE 1:  SELECT json_agg(x) FROM (VALUES ('a')) v(x) 
                ^
SELECT duckdb.raw_query($$ SELECT jsonb_agg(x) FROM (VALUES ('a')) v(x) $$);
ERROR:  (PGDuckDB/pgduckdb_raw_query_cpp) Catalog Error: Scalar Function with name jsonb_agg does not exist!
Did you mean "json"?

LINE 1:  SELECT jsonb_agg(x) FROM (VALUES ('a')) v(x) 
                ^
-- json_group_array is why the target is not that: a macro cannot take ORDER BY.
SELECT duckdb.raw_query($$ SELECT json_group_array(x ORDER BY x) FROM (VALUES ('a')) v(x) $$);
ERROR:  (PGDuckDB/pgduckdb_raw_query_cpp) Invalid Input Error: Function "json_group_array" is a Macro Function. "DISTINCT", "FILTER", and "ORDER BY" are only applicable to aggregate functions.
-- Cleanup.
DELETE FROM coldfront.tiered_views;
DELETE FROM coldfront.archive_watermark;
DROP VIEW public.events;
DROP TABLE public._events;
DROP TABLE public.src;
