-- (3) OVERRIDING SYSTEM VALUE supplies the identity on both tiers.
INSERT INTO public.cf_stream (id, ts, status) OVERRIDING SYSTEM VALUE
VALUES (901, '2026-01-11', 'ovr_cold'), (902, '2026-06-13', 'ovr_hot');
 hot_rows | cold_rows 
----------+-----------
