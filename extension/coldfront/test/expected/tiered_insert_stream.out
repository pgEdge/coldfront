-- (4) A prepared statement with a bound parameter streams from its cached plan
--     and keeps the parameter live. Run again in a transaction that wrote the
--     source table, the stream's check falls back to reading in this session,
--     so the row written in the transaction is tiered too.
PREPARE cf_prep(text) AS
  INSERT INTO public.cf_stream (ts, status) SELECT ts, $1 FROM public.cf_staging WHERE ts < '2026-03-01';
EXECUTE cf_prep('prep1');
 hot_rows | cold_rows 
----------+-----------
        0 |          
(1 row)

BEGIN;
INSERT INTO public.cf_staging VALUES ('2026-01-20', 'cold4', NULL, NULL, NULL);
EXECUTE cf_prep('prep2');
 hot_rows | cold_rows 
----------+-----------
        0 |         3
(1 row)

COMMIT;
BEGIN ISOLATION LEVEL REPEATABLE READ;
EXECUTE cf_prep('prep3');
 hot_rows | cold_rows 
----------+-----------
        0 |         3
(1 row)

COMMIT;
SELECT status, count(*) FROM public.cf_stream_cold WHERE status LIKE 'prep%' GROUP BY status ORDER BY status;
 status | count 
--------+-------
 prep1  |     2
 prep2  |     3
 prep3  |     3
(3 rows)

-- (5) COPY into the view goes through the same rewrite, batch by batch.
SET coldfront.cold_write_batch_size = 2;
COPY public.cf_stream (ts, status) FROM stdin WITH (FORMAT csv);
RESET coldfront.cold_write_batch_size;
SELECT status, count(*) FROM public.cf_stream_hot WHERE status LIKE 'copy%' GROUP BY status;
  status  | count 
----------+-------
 copy_hot |     1
(1 row)

SELECT status, count(*) FROM public.cf_stream_cold WHERE status LIKE 'copy%' GROUP BY status;
  status   | count 
-----------+-------
 copy_cold |     3
(1 row)

-- (6) Sources the hook sends to the sink in one pass: a volatile function, a
--     stable one, a temporary table, a WITH entry, a view that calls a stable
--     function, a table this transaction wrote, a transaction that is not READ
--     COMMITTED, and a session without local_pg_dsn.
EXPLAIN (COSTS OFF, VERBOSE)
  INSERT INTO public.cf_stream (ts, status) SELECT ts, random()::text FROM public.cf_staging;
                                                                                                                                                                 QUERY PLAN                                                                                                                                                                 
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: (InitPlan 4).col1, (InitPlan 5).col1
   CTE coldfront_source
     ->  Seq Scan on public.cf_staging
           Output: cf_staging.ts, (random())::text
   CTE coldfront_hot
     ->  Insert on public._cf_stream
           Output: 1
           ->  CTE Scan on coldfront_source
                 Output: nextval('_cf_stream_id_seq'), coldfront_source.ts, coldfront_source.status, 7, NULL::jsonb, NULL::bytea, NULL::integer[]
                 Filter: (coldfront_source.ts >= 'Sun Mar 01 00:00:00 2026 UTC'::timestamp with time zone)
   CTE coldfront_cold
     ->  Aggregate
           Output: _cold_sink('public'::text, 'cf_stream'::text, (string_agg((('('::text || _cold_row_literal(_canonical_jsonb(r.*), '{id,ts,status,n,data,b,tags}'::text[], '{bigint,"timestamp with time zone",text,integer,jsonb,bytea,integer[]}'::text[], 'public'::text, 'cf_stream'::text)) || ')'::text), ', '::text)), (count(*)))
           ->  HashAggregate
                 Output: string_agg((('('::text || _cold_row_literal(_canonical_jsonb(r.*), '{id,ts,status,n,data,b,tags}'::text[], '{bigint,"timestamp with time zone",text,integer,jsonb,bytea,integer[]}'::text[], 'public'::text, 'cf_stream'::text)) || ')'::text), ', '::text), count(*), r.coldfront_batch
                 Group Key: r.coldfront_batch
                 ->  Subquery Scan on r
                       Output: r.coldfront_batch, r.*
                       ->  WindowAgg
                             Output: (nextval('_cf_stream_id_seq'::regclass)), coldfront_source_1.ts, coldfront_source_1.status, (7), (NULL::jsonb), (NULL::bytea), (NULL::integer[]), ((row_number() OVER w1 - 1) / (current_setting('coldfront.cold_write_batch_size'::text))::integer)
                             Window: w1 AS (ROWS UNBOUNDED PRECEDING)
                             ->  CTE Scan on coldfront_source coldfront_source_1
                                   Output: nextval('_cf_stream_id_seq'::regclass), coldfront_source_1.ts, coldfront_source_1.status, 7, NULL::jsonb, NULL::bytea, NULL::integer[]
                                   Filter: (coldfront_source_1.ts < 'Sun Mar 01 00:00:00 2026 UTC'::timestamp with time zone)
   InitPlan 4
     ->  Aggregate
           Output: count(*)
           ->  CTE Scan on coldfront_hot
                 Output: coldfront_hot."?column?"
   InitPlan 5
     ->  CTE Scan on coldfront_cold
           Output: coldfront_cold.n
(33 rows)

