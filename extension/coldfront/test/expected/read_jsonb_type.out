  SELECT string_agg(e.id::text, ',' ORDER BY e.id) AS v FROM public.jhot e JOIN jhot_ids k ON k.id = e.id WHERE e.doc @> $1;
EXECUTE hot_dk('{"o": {"b": 1}}');
