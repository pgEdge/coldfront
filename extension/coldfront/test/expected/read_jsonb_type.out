  FROM public.jhot e JOIN public.jhot_flag f ON f.id = e.id \gset
SELECT :'v' = (SELECT string_agg(id || ':' || (doc -> 'o' = '{"b": 1}'), ',' ORDER BY id) FROM public._jhot) AS hot_view_inner_comparison_agg;
