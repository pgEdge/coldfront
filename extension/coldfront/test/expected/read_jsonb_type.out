EXECUTE by_decimal('{"d": 0.1234567890123456788}') \gset
SELECT :'v' = (SELECT COALESCE(string_agg(id::text, ',' ORDER BY id), 'none') FROM public._jdocs
                WHERE doc = '{"d": 0.1234567890123456788}') AS decimal_parameter;
