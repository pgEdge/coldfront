-- A bound parameter inside the INSERT's source, in a function in FROM or in a
-- sub-select, survives the rewrite: the rewritten statement re-binds every $N
-- the original carried, wherever it sat. Hot rows only; the regress server has
-- no warehouse.
-- Suppress the run-order-dependent "already exists" NOTICE: in the shared
-- regress db an earlier test may have created the extensions, standalone not.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS pg_duckdb;
CREATE EXTENSION IF NOT EXISTS coldfront;
RESET client_min_messages;
SET TIME ZONE 'UTC';
SET coldfront.warehouse = '';
SET coldfront.lakekeeper_endpoint = '';
SET coldfront.dblink_self = '';
CREATE TABLE public._events (id bigint GENERATED BY DEFAULT AS IDENTITY, ts timestamptz NOT NULL, status text);
CREATE VIEW public.events AS SELECT id, ts, status FROM public._events;
INSERT INTO coldfront.tiered_views(schema_name, relname, hot_table, iceberg_table, partition_col)
VALUES ('public', 'events', 'public._events', 'ice.default.events', 'ts');
INSERT INTO coldfront.archive_watermark(schema_name, table_name, cutoff_time)
VALUES ('public', 'events', '2026-03-01'::timestamptz);
-- The parameter feeds a function in FROM.
PREPARE p(text[]) AS
  INSERT INTO public.events (ts, status) SELECT '2026-04-01 00:00:00+00', s FROM unnest($1) AS s;
EXECUTE p(ARRAY['a', 'b']);
 hot_rows | cold_rows 
----------+-----------
        2 |         0
(1 row)

-- The parameter sits in a sub-select.
PREPARE q(text) AS
  INSERT INTO public.events (ts, status) SELECT '2026-04-01 00:00:00+00', (SELECT $1 || '!');
EXECUTE q('c');
 hot_rows | cold_rows 
----------+-----------
        1 |         0
(1 row)

SELECT id, status FROM public._events ORDER BY id;
 id | status 
----+--------
  1 | a
  2 | b
  3 | c!
(3 rows)

-- Cleanup.
DEALLOCATE p;
DEALLOCATE q;
DELETE FROM coldfront.tiered_views;
DELETE FROM coldfront.archive_watermark;
DROP VIEW public.events;
DROP TABLE public._events;
