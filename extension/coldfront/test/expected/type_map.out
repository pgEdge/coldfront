-- coldfront._iceberg_storage_type and coldfront._iceberg_view_cast_type are the
-- type map every path stores and reads a column by: the archiver reads a tiered
-- table's columns through them, and create_iceberg_table, the view rebuild and
-- the cold writers call them too. Their input is format_type(atttypid,
-- atttypmod), so the cases below are the columns of a real table.
--
-- Pure SQL: no catalog, no Iceberg I/O.
CREATE EXTENSION IF NOT EXISTS pg_duckdb;
NOTICE:  extension "pg_duckdb" already exists, skipping
CREATE EXTENSION IF NOT EXISTS coldfront;
NOTICE:  extension "coldfront" already exists, skipping
CREATE TABLE type_map_probe (
    c_bigint      bigint,
    c_integer     integer,
    c_smallint    smallint,
    c_real        real,
    c_double      double precision,
    c_boolean     boolean,
    c_timestamptz timestamptz,
    c_timestamp   timestamp,
    c_date        date,
    c_time        time,
    c_uuid        uuid,
    c_text        text,
    c_varchar     varchar(255),
    c_varchar_any varchar,
    c_char        char(10),
    c_bytea       bytea,
    c_numeric     numeric(20,5),
    c_numeric38   numeric(38,10),
    c_jsonb       jsonb,
    c_json        json,
    c_interval    interval
);
-- The storage type, and the cast the view applies where the storage type is not
-- the type the column reads as: smallint widens to INTEGER, which is its own
-- surface; DOUBLE and BLOB are not PostgreSQL spellings; json and interval are
-- stored as text and cast back.
SELECT a.attname,
       format_type(a.atttypid, a.atttypmod)                                    AS format_type,
       coldfront._iceberg_storage_type(format_type(a.atttypid, a.atttypmod))   AS storage,
       coldfront._iceberg_view_cast_type(format_type(a.atttypid, a.atttypmod)) AS view_cast
  FROM pg_attribute a
 WHERE a.attrelid = 'type_map_probe'::regclass AND a.attnum > 0
 ORDER BY a.attnum;
    attname    |         format_type         |    storage     |    view_cast     
---------------+-----------------------------+----------------+------------------
 c_bigint      | bigint                      | BIGINT         | 
 c_integer     | integer                     | INTEGER        | 
 c_smallint    | smallint                    | INTEGER        | 
 c_real        | real                        | REAL           | 
 c_double      | double precision            | DOUBLE         | double precision
 c_boolean     | boolean                     | BOOLEAN        | 
 c_timestamptz | timestamp with time zone    | TIMESTAMPTZ    | 
 c_timestamp   | timestamp without time zone | TIMESTAMP      | 
 c_date        | date                        | DATE           | 
 c_time        | time without time zone      | TIME           | 
 c_uuid        | uuid                        | UUID           | 
 c_text        | text                        | VARCHAR        | 
 c_varchar     | character varying(255)      | VARCHAR        | 
 c_varchar_any | character varying           | VARCHAR        | 
 c_char        | character(10)               | VARCHAR        | 
 c_bytea       | bytea                       | BLOB           | bytea
 c_numeric     | numeric(20,5)               | DECIMAL(20,5)  | 
 c_numeric38   | numeric(38,10)              | DECIMAL(38,10) | 
 c_jsonb       | jsonb                       | VARCHAR        | json
 c_json        | json                        | VARCHAR        | json
 c_interval    | interval                    | VARCHAR        | interval
(21 rows)

DROP TABLE type_map_probe;
-- Refused types. inet, cidr and oid would store, but pg_duckdb cannot plan a
-- query that reads them, and every read of a tiered table after its first
-- archive is planned by pg_duckdb.
SELECT coldfront._iceberg_storage_type('inet');
ERROR:  coldfront: PG type inet has no Iceberg-compatible mapping. Supported: bigint, integer, smallint, real, double precision, boolean, timestamptz, timestamp, date, time, uuid, text, varchar(N), char(N), bytea, numeric(P,S), jsonb, json, interval, vector(N), halfvec(N). inet/cidr/oid unsupported (store IP data as text, oid values as bigint); sparsevec unsupported (keep it in the hot tier)
CONTEXT:  PL/pgSQL function _iceberg_storage_type(text,text) line 44 at RAISE
SELECT coldfront._iceberg_storage_type('cidr');
ERROR:  coldfront: PG type cidr has no Iceberg-compatible mapping. Supported: bigint, integer, smallint, real, double precision, boolean, timestamptz, timestamp, date, time, uuid, text, varchar(N), char(N), bytea, numeric(P,S), jsonb, json, interval, vector(N), halfvec(N). inet/cidr/oid unsupported (store IP data as text, oid values as bigint); sparsevec unsupported (keep it in the hot tier)
CONTEXT:  PL/pgSQL function _iceberg_storage_type(text,text) line 44 at RAISE
