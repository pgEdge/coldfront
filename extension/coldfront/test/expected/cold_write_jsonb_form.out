DELETE FROM public.events WHERE ts < '2019-01-01'::timestamptz AND data > '9';
ERROR:  coldfront: > on a jsonb value is not supported on a tiered or decoupled view
HINT:  This statement runs in DuckDB, which sorts jsonb values by their text, not in jsonb's order. For example, the text 10 sorts before 9.
DELETE FROM public.events WHERE ts < '2019-01-01'::timestamptz AND data || '{}' = '{}';
ERROR:  coldfront: || on a jsonb value is not supported on a tiered or decoupled view
DELETE FROM public.events WHERE ts < '2019-01-01'::timestamptz AND ARRAY[data] = ARRAY['{}'::jsonb];
ERROR:  coldfront: = on an array or a row that holds jsonb is not supported on a tiered or decoupled view
HINT:  This statement runs in DuckDB, which compares the jsonb they hold by its text. Compare the jsonb values one by one.
-- The DuckDB statement names pg_duckdb's functions as DuckDB knows them,
-- whatever the session's search_path.
SET search_path = pg_catalog;
EXPLAIN (COSTS OFF, VERBOSE)
DELETE FROM public.events WHERE ts < '2019-01-01'::timestamptz AND data -> 'k' = '{"b": 1}';
                                                                                                                                 QUERY PLAN                                                                                                                                 
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: coldfront._exec_iceberg_with_claim('ice.default.events'::text, 'DELETE FROM ice.default.events   WHERE ((ts < ''2019-01-01 00:00:00+00''::timestamptz) AND (("json"(((data -> ''k''::text))::json))::text = ("json"((''{"b": 1}''::json)::json))::text))'::text)
(2 rows)

RESET search_path;
-- The key or path of ?, ?|, ?& and #> in a cold write must be a constant: the
-- rewrite needs its value, and a cold write's parameters are bound as it runs.
PREPARE dk(text) AS DELETE FROM public.events WHERE ts < '2019-01-01'::timestamptz AND data ? $1;
ERROR:  ? on a tiered or decoupled view needs its path or key as a constant, or as a bound parameter in a read
-- On both tiers the hot half keeps PostgreSQL's comparison and the cold half gets
-- the rewrite; a move of the partition column reads its cold rows with the
-- rewritten condition.
EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events SET note = 'x' WHERE id = 7 AND data = '{"a": 1}';
                                                                                             QUERY PLAN                                                                                              
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Nested Loop
   Output: h.id, h.ts, h.data, h.alt, h.note, h.j
   CTE coldfront_hot
     ->  Update on public._events
           Output: _events.id, _events.ts, _events.data, _events.alt, _events.note, _events.j
           ->  Seq Scan on public._events
                 Output: 'x'::text, _events.ctid
                 Filter: ((_events.id = 7) AND (_events.data = '{"a": 1}'::jsonb))
   CTE coldfront_cold
     ->  Result
           Output: _exec_iceberg_with_claim('ice.default.events'::text, 'UPDATE ice.default.events SET note = ''x''::text   WHERE ((id = 7) AND ((data)::text = (''{"a": 1}''::json)::text))'::text)
   ->  CTE Scan on coldfront_hot h
         Output: h.id, h.ts, h.data, h.alt, h.note, h.j
   ->  CTE Scan on coldfront_cold c
         Output: c._exec_iceberg_with_claim
(15 rows)

EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events SET ts = ts + interval '1 day' WHERE data = '{"a": 1}';
                                                                                          QUERY PLAN                                                                                          
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _cross_tier_move('public'::text, 'events'::text, '(data = ''{"a": 1}''::jsonb)'::text, '(ts + ''@ 1 day''::interval)'::text, '((data)::text = (''{"a": 1}''::jsonb)::text)'::text)
(2 rows)

-- Cleanup.
DELETE FROM coldfront.tiered_views;
DELETE FROM coldfront.archive_watermark;
DROP VIEW public.events, public.dv;
DROP TABLE public._events, public._dv, public.src;
DROP DOMAIN public.jdoc;
