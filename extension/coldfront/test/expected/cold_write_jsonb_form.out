-- The part of a cold write that DuckDB evaluates, its condition and a decoupled
-- INSERT's source, gets the rewrite a read DuckDB runs gets: a stored document
-- compares with a constant as text, a value DuckDB computes through json(), an
-- operator DuckDB lacks becomes DuckDB's function, and an ordering or an
-- untranslated operator is refused.
EXPLAIN (COSTS OFF, VERBOSE)
DELETE FROM public.events WHERE ts < '2019-01-01'::timestamptz AND data = '{"b":1,   "a":2}';
                                                                                                       QUERY PLAN                                                                                                        
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _exec_iceberg_with_claim('ice.default.events'::text, 'DELETE FROM ice.default.events   WHERE ((ts < ''2019-01-01 00:00:00+00''::timestamptz) AND ((data)::text = (''{"a": 2, "b": 1}''::json)::text))'::text)
(2 rows)

EXPLAIN (COSTS OFF, VERBOSE)
DELETE FROM public.events WHERE ts < '2019-01-01'::timestamptz AND data -> 'k' = '{"b": 1}';
                                                                                                                            QUERY PLAN                                                                                                                            
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _exec_iceberg_with_claim('ice.default.events'::text, 'DELETE FROM ice.default.events   WHERE ((ts < ''2019-01-01 00:00:00+00''::timestamptz) AND (("json"(((data -> ''k''::text))::json))::text = ("json"((''{"b": 1}''::json)::json))::text))'::text)
(2 rows)

EXPLAIN (COSTS OFF, VERBOSE)
UPDATE public.events SET note = 'x' WHERE ts < '2019-01-01'::timestamptz AND data ? 'k';
                                                                                                                                                                                                                                                       QUERY PLAN                                                                                                                                                                                                                                                       
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: _exec_iceberg_with_claim('ice.default.events'::text, 'UPDATE ice.default.events SET note = ''x''::text   WHERE ((ts < ''2019-01-01 00:00:00+00''::timestamptz) AND ("json_exists"((data)::json, (''/k''::text)::varchar) OR json_contains(((((''{"\u0000":''::text || (data)::text) || ''}''::text))::json)::json, ((''{"\u0000":["k"]}''::text)::json)::json) OR json_contains(((((''{"\u0000":''::text || (data)::text) || ''}''::text))::json)::json, ((''{"\u0000":"k"}''::text)::json)::json)))'::text)
(2 rows)

