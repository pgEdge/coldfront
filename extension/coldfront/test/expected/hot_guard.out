ERROR:  new row for relation "_guarded_p1" violates check constraint "coldfront_guard_due"
DETAIL:  Failing row contains (2, Tue Jan 06 00:00:00 2026 PST, 1.00, infinity, null, y).
UPDATE public._guarded SET logged = '-infinity' WHERE id = 1;
ERROR:  new row for relation "_guarded_p1" violates check constraint "coldfront_guard_logged"
DETAIL:  Failing row contains (1, Mon Jan 05 00:00:00 2026 PST, 1.25, 02-01-2026, -infinity, x).
