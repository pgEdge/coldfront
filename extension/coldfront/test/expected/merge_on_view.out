(2 rows)

-- Cleanup.
DELETE FROM coldfront.tiered_views;
DELETE FROM coldfront.archive_watermark;
DROP VIEW public.events, public.plain, public.iceplain;
DROP TABLE public._events, public._plain, public._ice_base, public.src;
